<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260703065800" author="sakshi">

        <createTable tableName="subscription">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="subscription_id" type="VARCHAR(255)"/>

            <column name="plan_id" type="VARCHAR(255)"/>

            <column name="status" type="VARCHAR(50)"/>

            <column name="user_id" type="BIGINT"/>

            <column name="created_by" type="BIGINT"/>

            <column name="updated_by" type="BIGINT"/>

            <column name="created_at" type="TIMESTAMP"/>

            <column name="updated_at" type="TIMESTAMP"/>

        </createTable>

        <!-- Foreign Key for user -->
        <addForeignKeyConstraint
                baseTableName="subscription"
                baseColumnNames="user_id"
                constraintName="fk_subscription_user"
                referencedTableName="user"
                referencedColumnNames="id"/>

        <!-- Foreign Key for created_by -->
        <addForeignKeyConstraint
                baseTableName="subscription"
                baseColumnNames="created_by"
                constraintName="fk_subscription_created_by"
                referencedTableName="user"
                referencedColumnNames="id"/>

        <!-- Foreign Key for updated_by -->
        <addForeignKeyConstraint
                baseTableName="subscription"
                baseColumnNames="updated_by"
                constraintName="fk_subscription_updated_by"
                referencedTableName="user"
                referencedColumnNames="id"/>

    </changeSet>

</databaseChangeLog>